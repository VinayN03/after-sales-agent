# AI Gateway Configuration
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=your-gateway-url

# Model (optional, defaults to @makers/deepseek-v4-flash)
# AI_GATEWAY_MODEL=@makers/deepseek-v4-flash
# ── Optional ────────────────────────────────────────────────────────────────────
# Operator passcodes that prove the approver role on the server (defaults shown; change them for any real use).
# SUPPORT_PASSCODE=support-demo
# MANAGER_PASSCODE=manager-demo

# Local development only:
# PY_SERVICE_URL=http://127.0.0.1:8001   # point the agents at a locally running FastAPI service (uvicorn)
# LOCAL_STORE_FALLBACK=1                 # in-memory store when the platform's storage host is unreachable
